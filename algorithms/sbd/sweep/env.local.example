# Copy to sweep/.env.local (gitignored) and fill in. The launcher .sh files source this so IBM
# credentials never live in a committed file. NEVER commit .env.local.
export IBM_API_KEY="your-ibm-quantum-api-key"
export IBM_CRN="crn:v1:bluemix:public:quantum-computing:..."
export IBM_BACKEND="ibm_kingston"
